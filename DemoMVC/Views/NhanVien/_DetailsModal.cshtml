@model DemoMVC.Models.NhanVien

<div class="modal-header">
    <h5 class="modal-title">Thông tin nhân viên</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>
<div class="modal-body">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MaNhanVien)</dt>
        <dd class="col-sm-8">@Model.MaNhanVien</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.HoTen)</dt>
        <dd class="col-sm-8">@Model.HoTen</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ChucVu)</dt>
        <dd class="col-sm-8">@Model.ChucVu</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PhongBan)</dt>
        <dd class="col-sm-8">@Model.PhongBan</dd>
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Luong)</dt>
        <dd class="col-sm-8">@Model.Luong</dd>
    </dl>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
</div>
