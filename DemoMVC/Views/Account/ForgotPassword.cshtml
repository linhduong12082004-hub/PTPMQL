@model DemoMVC.Models.EmailViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1>Quên mật khẩu</h1>
        <p>Nhập email đã đăng ký. Hệ thống không tiết lộ email có tồn tại hay không.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Gửi hướng dẫn</button>
            <a asp-action="Login" class="btn btn-link">Quay lại đăng nhập</a>
        </form>
    </div>
</div>
