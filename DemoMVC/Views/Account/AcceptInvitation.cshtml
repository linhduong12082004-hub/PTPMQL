@model DemoMVC.Models.AcceptInvitationViewModel

@{
    ViewData["Title"] = "Thiết lập tài khoản";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1>Thiết lập tài khoản</h1>
        <p>Email tài khoản: <strong>@Model.Email</strong></p>
        <form asp-action="AcceptInvitation" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="EmailToken" type="hidden" />
            <input asp-for="PasswordToken" type="hidden" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Xác minh và kích hoạt</button>
        </form>
    </div>
</div>
