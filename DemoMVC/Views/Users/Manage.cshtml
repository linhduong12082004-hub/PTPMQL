@model DemoMVC.Models.UserRolesViewModel

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h1>Quản lý tài khoản</h1>
        <p><strong>@Model.UserName</strong> · @Model.Email</p>
        <form asp-action="Manage" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="Id" type="hidden" />
            <input asp-for="UserName" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <fieldset class="mb-3">
                <legend class="col-form-label">Vai trò</legend>
                @for (var index = 0; index < Model.AvailableRoles.Count; index++)
                {
                    var role = Model.AvailableRoles[index];
                    var checkboxId = $"role-{index}";
                    <div class="form-check">
                        <input type="checkbox"
                               class="form-check-input"
                               id="@checkboxId"
                               name="SelectedRoles"
                               value="@role"
                               checked="@Model.SelectedRoles?.Contains(role, StringComparer.Ordinal)" />
                        <label class="form-check-label" for="@checkboxId">@role</label>
                    </div>
                }
            </fieldset>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-link">Quay lại</a>
        </form>
    </div>
</div>
