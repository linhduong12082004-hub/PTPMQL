@model IReadOnlyList<DemoMVC.Models.UserListItemViewModel>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<h1>Quản lý tài khoản</h1>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ Tạo tài khoản</a>
</p>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tên đăng nhập</th>
                <th>Email</th>
                <th>Họ tên</th>
                <th>Vai trò</th>
                <th>Email xác minh</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Chưa có tài khoản.</td>
                </tr>
            }
            else
            {
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>@user.FullName</td>
                        <td>@user.Roles</td>
                        <td>@(user.EmailConfirmed ? "Đã xác minh" : "Chưa xác minh")</td>
                        <td>@(user.IsActive ? "Hoạt động" : "Đã vô hiệu hóa")</td>
                        <td class="text-nowrap">
                            <a asp-action="Manage" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm">Quản lý</a>
                            @if (!user.HasPassword)
                            {
                                <form asp-action="ResendInvitation" asp-route-id="@user.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Gửi lại lời mời</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
